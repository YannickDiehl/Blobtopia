# Globtopia Static — Environment Variables
# Copy to .env and fill in your values

# Anthropic API key for chat feature (required for chat, optional otherwise)
ANTHROPIC_API_KEY=sk-ant-...

# Chat model (optional, default: claude-haiku-4-5-20251001)
CHAT_MODEL=claude-haiku-4-5-20251001

# Max tokens per chat response (optional, default: 512)
CHAT_MAX_TOKENS=512

# Bearer token for chat auth (optional — if set, students need this token)
# CHAT_BEARER_TOKEN=your-secret-token

# Vue app settings (optional)
# VUE_APP_DATA_BASE=/data/timeline
# VUE_APP_CHAT_API=/api/chat
